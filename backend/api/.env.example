AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Region of S3_RESUME_BUCKET — presigned export URLs must be signed for it.
AWS_REGION=
S3_RESUME_BUCKET=

AMQP_URL=amqp://guest:guest@amqp:5672

PG_URL=postgres://resland:resland@postgres:5432/resland

AUTH0_DOMAIN=
AUTH0_AUDIENCE=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FRONTEND_BASE_URL=http://localhost:3000

# Optional seed for site_settings.maintenance_mode on first read only — the
# admin dashboard owns the flag afterwards. Set to 1/true to keep a fresh
# deploy paused.
MAINTENANCE_MODE=
