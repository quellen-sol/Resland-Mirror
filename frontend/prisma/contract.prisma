// use prisma-next

model User {
  auth0_id            String   @id
  has_onboarded       Boolean  @default(false)
  // USD cents, fractional — sub-cent charges from cheap models still count.
  balance_cents       Decimal  @default("0")
  site_admin          Boolean  @default(false)
  stripe_customer_id  String?
  created_at          DateTime @default(now())
  // For resume headers
  full_name           String?
  email               String?
  phone               String?
  location            String?
  // Professional summary parsed from the uploaded resume. Optional — not
  // every resume has one.
  summary             String?

  @@map("user")
  @@index([auth0_id])
}

enum SocialLinkType {
  LINKEDIN
  GITHUB
  WEBSITE
}

model UserSocialLink {
  id      Int            @id @default(autoincrement())
  link    String
  type    SocialLinkType
  user_id String
  user    User           @relation(fields: [user_id], references: [auth0_id])

  @@map("user_social_link")
  @@unique([user_id, type])
  @@index([user_id])
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model UserUploadJob {
  id         String    @id
  user_id    String
  user       User      @relation(fields: [user_id], references: [auth0_id])
  status     JobStatus @default(PENDING)
  s3_key     String
  created_at DateTime  @default(now())

  @@map("user_upload_job")
  @@index([user_id])
}


// User "base" models, from resume generated data only
model UserBaseExperience {
  id           Int       @id @default(autoincrement())
  user_id      String
  user         User      @relation(fields: [user_id], references: [auth0_id])
  company_name String
  title        String
  start_date   String
  end_date     String?
  description  String?
  created_at   DateTime  @default(now())

  @@map("user_base_experience")
  @@index([user_id])
}

model UserBaseExperienceBullet {
  id                 Int                @id @default(autoincrement())
  user_experience_id Int
  user_experience    UserBaseExperience @relation(fields: [user_experience_id], references: [id])
  bullet             String
  bullet_order       Int
  created_at         DateTime           @default(now())

  @@map("user_base_experience_bullet")
  @@index([user_experience_id, bullet_order], map: "bullet_exp_order_idx")
}

model UserBaseSkill {
  id         Int     @id @default(autoincrement())
  user_id    String
  user       User    @relation(fields: [user_id], references: [auth0_id])
  name       String
  category   String?
  // Display order across all of the user's skills — groups render as
  // contiguous runs of the same category in this order.
  sort_order Int     @default(0)

  @@map("user_base_skill")
  @@unique([user_id, name])
  @@index([user_id])
}

model UserBaseEducation {
  id            Int     @id @default(autoincrement())
  user_id       String
  user          User    @relation(fields: [user_id], references: [auth0_id])
  institution   String
  degree        String
  field_of_study String
  start_date    String
  end_date      String?
  description   String?

  @@map("user_base_education")
  @@unique([user_id, institution, degree, field_of_study, start_date])
  @@index([user_id])
}

model UserBaseProject {
  id          Int     @id @default(autoincrement())
  user_id     String
  user        User    @relation(fields: [user_id], references: [auth0_id])
  name        String
  link        String?
  description String?
  start_date  String
  end_date    String?

  @@map("user_base_project")
  @@unique([user_id, name, start_date])
  @@unique([user_id, link])
  @@index([user_id])
}

enum SuggestionStatus {
  PROCESSING
  WAITING_FOR_INPUT
  COMPLETED
  FAILED
}

model UserSuggestion {
  id               String                      @id
  user_id          String
  user             User                        @relation(fields: [user_id], references: [auth0_id])
  experience_id    Int
  experience       UserBaseExperience          @relation(fields: [experience_id], references: [id])
  bullet_id        Int?
  bullet           UserBaseExperienceBullet?   @relation(fields: [bullet_id], references: [id])
  // Null = system default model.
  model            String?
  pending_question String?
  result           String?
  status           SuggestionStatus            @default(PROCESSING)
  created_at       DateTime                    @default(now())

  @@map("user_suggestion")

  @@index([user_id])
  @@unique([user_id, experience_id, bullet_id])
}

enum TailorStatus {
  PROCESSING
  WAITING_FOR_INPUT
  COMPLETED
  FAILED
}

// A tailor-run tailors the base profile to one pasted job description.
// `result` holds the tailored resume JSON once COMPLETED.
model UserTailorRun {
  id               String       @id
  user_id          String
  user             User         @relation(fields: [user_id], references: [auth0_id])
  job_description  String
  // Target company/role captured with the JD — surfaced to the agent and
  // copied onto the saved tailored resume.
  company_name     String?
  role             String?
  // Null = system default model.
  model            String?
  pending_question String?
  result           String?
  status           TailorStatus @default(PROCESSING)
  created_at       DateTime     @default(now())

  @@map("user_tailor_run")

  @@index([user_id])
}

enum MemorySource {
  TAILOR
  SUGGESTION
  USER
}

// The user's memory bank: facts about their work that the tailor and
// suggestion agents learned from interview answers (or the user typed in), so
// later runs use them instead of asking again. `topic` names what a fact is
// about in words ("Senior Engineer at Acme", "Preferences") rather than an FK,
// because base experience rows are rebuilt on every resume re-upload.
model UserMemoryFact {
  id         Int          @id @default(autoincrement())
  user_id    String
  user       User         @relation(fields: [user_id], references: [auth0_id])
  topic      String
  content    String
  source     MemorySource
  created_at DateTime     @default(now())
  updated_at DateTime     @default(now())

  @@map("user_memory_fact")
  @@index([user_id])
}

// A saved tailored resume on the board — a self-contained snapshot of the
// tailor result. Base rows are rebuilt on every resume re-upload, so the
// snapshot keeps the tailored copy intact.
model UserTailoredResume {
  id              String    @id
  user_id         String
  user            User      @relation(fields: [user_id], references: [auth0_id])
  // Run that produced it — plain column, no FK: runs are deleted on dismiss.
  tailor_run_id   String?
  company_name    String?
  role            String?
  job_description String
  // Editable snapshot JSON: {summary, experiences[], skill_groups[]},
  // resolved against the base profile at save time.
  content         String
  // Generated docx bookkeeping — mirrors user_generated_resume at the
  // per-tailored-resume key resumes/<user_id>/tailored/<id>.docx.
  s3_key          String?
  source_hash     String?
  generated_at    DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @default(now())

  @@map("user_tailored_resume")

  @@index([user_id])
  // Saving a run twice must not duplicate the board entry — NULLs don't
  // conflict, so rows without a run stay insertable.
  @@unique([user_id, tailor_run_id])
}

// Resume layout captured from the user's uploaded doc at parse time.
// `format` is the serialized FormatProfile JSON (see shared.docgen) used
// to regenerate the docx — the "Original" template.
model UserResumeFormat {
  user_id       String   @id
  user          User     @relation(fields: [user_id], references: [auth0_id])
  format        String
  source_job_id String?
  captured_at   DateTime @default(now())

  @@map("user_resume_format")
}

// The most recently generated resume per user — always stored at the
// fixed s3 key resumes/<user_id>/generated.docx. `source_hash` covers
// the content + template the doc was built from; export regenerates
// lazily when it differs.
model UserGeneratedResume {
  user_id      String   @id
  user         User     @relation(fields: [user_id], references: [auth0_id])
  template     String   @default("original")
  s3_key       String
  source_hash  String
  generated_at DateTime @default(now())

  @@map("user_generated_resume")
}

// Whitelist of selectable models, priced in cents per 1K tokens.
// `id` is the langchain model spec, e.g. "openrouter:openai/gpt-5-mini".
model ModelPricing {
  id                    String  @id
  display_name          String
  cents_per_1k_input    Decimal
  cents_per_1k_output   Decimal
  enabled               Boolean @default(true)
  is_default            Boolean @default(false)
  sort_order            Int     @default(0)

  @@map("model_pricing")
}

enum UsageJobKind {
  SUGGESTION
  TAILOR
  SYSTEM_DESIGN
}

// Ledger of billed LLM usage — one row per dispatcher task invocation.
model TokenUsage {
  id              Int          @id @default(autoincrement())
  user_id         String
  user            User         @relation(fields: [user_id], references: [auth0_id])
  job_kind        UsageJobKind
  job_id          String
  model           String
  input_tokens               Int
  output_tokens              Int
  amount_cents               Decimal
  // OpenRouter generation stats: actual billed cost (pre-markup) + ids for
  // tracing a ledger row back to individual provider calls.
  actual_cost_cents          Decimal?
  openrouter_generation_ids  String[]     @default([])
  created_at                 DateTime     @default(now())

  @@map("token_usage")
  // One ledger row per job — a redelivered AMQP message can't charge twice.
  @@unique([job_kind, job_id])
  @@index([user_id])
  @@index([created_at])
}

enum SystemDesignStatus {
  PROCESSING
  WAITING_FOR_INPUT
  COMPLETED
  FAILED
}

// Interview phases, in order. FEEDBACK = the interview is over: grading
// while PROCESSING, report ready once COMPLETED.
enum SystemDesignPhase {
  REQUIREMENTS
  ESTIMATION
  HIGH_LEVEL_DESIGN
  DEEP_DIVE
  FEEDBACK
}

enum SystemDesignSource {
  BANK
  JOB
}

enum SystemDesignLevel {
  MID
  SENIOR
  STAFF
}

// A system design mock interview. The API owns phase moves the candidate
// makes; the dispatcher writes the brief, interviewer turns, and the report.
model UserSystemDesignSession {
  id                 String             @id
  user_id            String
  user               User               @relation(fields: [user_id], references: [auth0_id])
  source             SystemDesignSource
  // Curated bank key (shared.system_design.bank) for BANK sessions.
  problem_id         String?
  // Saved tailored resume a JOB session was built from — plain column, no
  // FK: the posting is snapshotted below so deleting the resume is safe.
  tailored_resume_id String?
  company_name       String?
  role               String?
  job_description    String?
  level              SystemDesignLevel  @default(SENIOR)
  // Null = system default model.
  model              String?
  status             SystemDesignStatus @default(PROCESSING)
  phase              SystemDesignPhase  @default(REQUIREMENTS)
  // Problem shown to the candidate — null until the first turn writes it.
  title              String?
  prompt             String?
  // Hidden interviewer brief JSON (scale answers, expected requirements,
  // reference design, deep-dive topics). Only revealed once COMPLETED.
  brief              String?
  // Candidate workspace, autosaved. `diagram` is the Excalidraw elements JSON.
  requirements       String             @default("")
  estimates          String             @default("")
  diagram            String             @default("[]")
  // What the interviewer last saw (content hashes + diagram graph) so each
  // turn only sends what changed.
  agent_context      String?
  // Turn id the dispatcher last finished — a redelivered job is a no-op.
  last_turn_id       String?
  // Set when a turn crashed; the candidate retries instead of answering.
  notice             String?
  // JSON {phase: seconds} for each phase the candidate has left.
  phase_durations    String             @default("{}")
  phase_started_at   DateTime           @default(now())
  // Graded report JSON — rubric scores, letter grade, hire signal, feedback.
  result             String?
  letter_grade       String?
  hire_signal        String?
  created_at         DateTime           @default(now())
  completed_at       DateTime?

  @@map("user_system_design_session")
  @@index([user_id])
}

enum SystemDesignRole {
  INTERVIEWER
  CANDIDATE
}

// Interview transcript: candidate turns are written by the API, interviewer
// turns by the dispatcher. Ordered by id.
model SystemDesignMessage {
  id         Int                     @id @default(autoincrement())
  session_id String
  session    UserSystemDesignSession @relation(fields: [session_id], references: [id])
  role       SystemDesignRole
  phase      SystemDesignPhase
  content    String
  created_at DateTime                @default(now())

  @@map("system_design_message")
  @@index([session_id])
}

// Site-wide kill switches toggled from /admin — a single row (id = 1).
// Both backends read it through a short-TTL in-process cache so requests
// never hit the table; writes go through PUT /admin/settings.
model SiteSettings {
  id               Int      @id @default(1)
  maintenance_mode Boolean  @default(false)
  payments_paused  Boolean  @default(false)
  updated_at       DateTime @default(now())

  @@map("site_settings")
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  EXPIRED
  REFUNDED
}

// One row per Stripe Checkout session; `id` is the Stripe session id so the
// webhook top-up is idempotent.
model BalancePurchase {
  id           String         @id
  user_id      String
  user         User           @relation(fields: [user_id], references: [auth0_id])
  cents        Int
  amount_cents Int
  currency     String
  // Links the purchase back to the Stripe PaymentIntent so a later
  // charge.refunded event can find and claw back this credit.
  payment_intent_id String?
  status       PurchaseStatus @default(PENDING)
  created_at   DateTime       @default(now())

  @@map("balance_purchase")
  @@index([user_id])
}

// DSA study center topics a user has marked as studied — a row means
// studied, un-marking deletes it. `topic` is a slug from content/dsa; the
// topics live in code, so there's no FK and stale slugs are ignored on read.
model UserDsaProgress {
  id         Int      @id @default(autoincrement())
  user_id    String
  user       User     @relation(fields: [user_id], references: [auth0_id])
  topic      String
  created_at DateTime @default(now())

  @@map("user_dsa_progress")
  @@unique([user_id, topic])
  @@index([user_id])
}

// Where a visit came from, decided on its first page. Later pages in the same
// visit are INTERNAL.
enum TrafficSource {
  SEARCH
  AI
  SOCIAL
  REFERRAL
  DIRECT
  INTERNAL
}

// First-party traffic log behind /admin's Traffic panel: one row per page
// load or client-side navigation. Anonymous by design, with no IP, user agent
// or user id. `visit_id` is a random per-tab id kept in sessionStorage, so a
// visit's pages group together without a cookie.
model PageView {
  id           Int           @id @default(autoincrement())
  visit_id     String
  // Route path with ids masked, e.g. /tailored/[id] (see lib/traffic.ts).
  path         String
  // The page this tab was on before; null on a visit's first page.
  prev_path    String?
  source       TrafficSource
  // "google", "chatgpt", "reddit", or the referrer host. Null for DIRECT and
  // INTERNAL.
  source_name  String?
  utm_campaign String?
  created_at   DateTime      @default(now())

  @@map("page_view")
  @@index([created_at])
}
