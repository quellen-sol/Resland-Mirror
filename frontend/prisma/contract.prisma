// use prisma-next

model User {
  auth0_id            String   @id
  has_onboarded       Boolean  @default(false)
  // USD cents, fractional — sub-cent charges from cheap models still count.
  balance_cents       Decimal  @default("100")
  site_admin          Boolean  @default(false)
  stripe_customer_id  String?
  created_at          DateTime @default(now())
  // For resume headers
  full_name           String?
  email               String?
  phone               String?
  location            String?

  @@map("user")
  @@index([auth0_id])
}

enum SocialLinkType {
  LINKEDIN
  GITHUB
  WEBSITE
}

model UserSocialLink {
  id      Int            @id @default(autoincrement())
  link    String
  type    SocialLinkType
  user_id String
  user    User           @relation(fields: [user_id], references: [auth0_id])

  @@map("user_social_link")
  @@unique([user_id, type])
  @@index([user_id])
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model UserUploadJob {
  id         String    @id
  user_id    String
  user       User      @relation(fields: [user_id], references: [auth0_id])
  status     JobStatus @default(PENDING)
  s3_key     String
  created_at DateTime  @default(now())

  @@map("user_upload_job")
  @@index([user_id])
}


// User "base" models, from resume generated data only
model UserBaseExperience {
  id           Int       @id @default(autoincrement())
  user_id      String
  user         User      @relation(fields: [user_id], references: [auth0_id])
  company_name String
  title        String
  start_date   String
  end_date     String?
  description  String?
  created_at   DateTime  @default(now())

  @@map("user_base_experience")
  @@index([user_id])
}

model UserBaseExperienceBullet {
  id                 Int                @id @default(autoincrement())
  user_experience_id Int
  user_experience    UserBaseExperience @relation(fields: [user_experience_id], references: [id])
  bullet             String
  bullet_order       Int
  created_at         DateTime           @default(now())

  @@map("user_base_experience_bullet")
  @@index([user_experience_id, bullet_order], map: "bullet_exp_order_idx")
}

model UserBaseSkill {
  id       Int     @id @default(autoincrement())
  user_id  String
  user     User    @relation(fields: [user_id], references: [auth0_id])
  name     String
  category String?

  @@map("user_base_skill")
  @@unique([user_id, name])
  @@index([user_id])
}

model UserBaseEducation {
  id            Int     @id @default(autoincrement())
  user_id       String
  user          User    @relation(fields: [user_id], references: [auth0_id])
  institution   String
  degree        String
  field_of_study String
  start_date    String
  end_date      String?
  description   String?

  @@map("user_base_education")
  @@unique([user_id, institution, degree, field_of_study, start_date])
  @@index([user_id])
}

model UserBaseProject {
  id          Int     @id @default(autoincrement())
  user_id     String
  user        User    @relation(fields: [user_id], references: [auth0_id])
  name        String
  link        String?
  description String?
  start_date  String
  end_date    String?

  @@map("user_base_project")
  @@unique([user_id, name, start_date])
  @@unique([user_id, link])
  @@index([user_id])
}

enum SuggestionStatus {
  PROCESSING
  WAITING_FOR_INPUT
  COMPLETED
}

model UserSuggestion {
  id               String                      @id
  user_id          String
  user             User                        @relation(fields: [user_id], references: [auth0_id])
  experience_id    Int
  experience       UserBaseExperience          @relation(fields: [experience_id], references: [id])
  bullet_id        Int?
  bullet           UserBaseExperienceBullet?   @relation(fields: [bullet_id], references: [id])
  // Null = system default model.
  model            String?
  pending_question String?
  result           String?
  status           SuggestionStatus            @default(PROCESSING)
  created_at       DateTime                    @default(now())

  @@map("user_suggestion")

  @@index([user_id])
  @@unique([user_id, experience_id, bullet_id])
}

enum TailorStatus {
  PROCESSING
  WAITING_FOR_INPUT
  COMPLETED
  FAILED
}

// A tailor-run tailors the base profile to one pasted job description.
// `result` holds the tailored resume JSON once COMPLETED.
model UserTailorRun {
  id               String       @id
  user_id          String
  user             User         @relation(fields: [user_id], references: [auth0_id])
  job_description  String
  // Null = system default model.
  model            String?
  pending_question String?
  result           String?
  status           TailorStatus @default(PROCESSING)
  created_at       DateTime     @default(now())

  @@map("user_tailor_run")

  @@index([user_id])
}

// Whitelist of selectable models, priced in cents per 1K tokens.
// `id` is the langchain model spec, e.g. "openrouter:openai/gpt-5-mini".
model ModelPricing {
  id                    String  @id
  display_name          String
  cents_per_1k_input    Decimal
  cents_per_1k_output   Decimal
  enabled               Boolean @default(true)
  is_default            Boolean @default(false)
  sort_order            Int     @default(0)

  @@map("model_pricing")
}

enum UsageJobKind {
  SUGGESTION
  TAILOR
}

// Ledger of billed LLM usage — one row per dispatcher task invocation.
model TokenUsage {
  id              Int          @id @default(autoincrement())
  user_id         String
  user            User         @relation(fields: [user_id], references: [auth0_id])
  job_kind        UsageJobKind
  job_id          String
  model           String
  input_tokens               Int
  output_tokens              Int
  amount_cents               Decimal
  // OpenRouter generation stats: actual billed cost (pre-markup) + ids for
  // tracing a ledger row back to individual provider calls.
  actual_cost_cents          Decimal?
  openrouter_generation_ids  String[]     @default([])
  created_at                 DateTime     @default(now())

  @@map("token_usage")
  @@index([user_id])
  @@index([created_at])
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  EXPIRED
}

// One row per Stripe Checkout session; `id` is the Stripe session id so the
// webhook top-up is idempotent.
model BalancePurchase {
  id           String         @id
  user_id      String
  user         User           @relation(fields: [user_id], references: [auth0_id])
  cents        Int
  amount_cents Int
  currency     String
  status       PurchaseStatus @default(PENDING)
  created_at   DateTime       @default(now())

  @@map("balance_purchase")
  @@index([user_id])
}
