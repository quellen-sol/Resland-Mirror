// use prisma-next

model User {
  auth0_id      String   @id
  has_onboarded Boolean  @default(false)
  created_at    DateTime @default(now())
  // For resume headers
  full_name     String?
  email         String?
  phone         String?
  location      String?

  @@map("user")
  @@index([auth0_id])
}

enum SocialLinkType {
  LINKEDIN
  GITHUB
  WEBSITE
}

model UserSocialLink {
  id      Int            @id @default(autoincrement())
  link    String
  type    SocialLinkType
  user_id String
  user    User           @relation(fields: [user_id], references: [auth0_id])

  @@map("user_social_link")
  @@unique([user_id, type])
  @@index([user_id])
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model UserUploadJob {
  id         String    @id
  user_id    String
  user       User      @relation(fields: [user_id], references: [auth0_id])
  status     JobStatus @default(PENDING)
  s3_key     String
  created_at DateTime  @default(now())

  @@map("user_upload_job")
  @@index([user_id])
}


// User "base" models, from resume generated data only
model UserBaseExperience {
  id           Int       @id @default(autoincrement())
  user_id      String
  user         User      @relation(fields: [user_id], references: [auth0_id])
  company_name String
  title        String
  start_date   String
  end_date     String?
  description  String?
  created_at   DateTime  @default(now())

  @@map("user_base_experience")
  @@index([user_id])
}

model UserBaseExperienceBullet {
  id                 Int                @id @default(autoincrement())
  user_experience_id Int
  user_experience    UserBaseExperience @relation(fields: [user_experience_id], references: [id])
  bullet             String
  created_at         DateTime           @default(now())

  @@map("user_base_experience_bullet")
  @@index([user_experience_id])
}

model UserBaseSkill {
  id       Int     @id @default(autoincrement())
  user_id  String
  user     User    @relation(fields: [user_id], references: [auth0_id])
  name     String
  category String?

  @@map("user_base_skill")
  @@unique([user_id, name])
  @@index([user_id])
}

model UserBaseEducation {
  id            Int     @id @default(autoincrement())
  user_id       String
  user          User    @relation(fields: [user_id], references: [auth0_id])
  institution   String
  degree        String
  field_of_study String
  start_date    String
  end_date      String?
  description   String?

  @@map("user_base_education")
  @@unique([user_id, institution, degree, field_of_study, start_date])
  @@index([user_id])
}

model UserBaseProject {
  id          Int     @id @default(autoincrement())
  user_id     String
  user        User    @relation(fields: [user_id], references: [auth0_id])
  name        String
  link        String?
  description String?
  start_date  String
  end_date    String?

  @@map("user_base_project")
  @@unique([user_id, name, start_date])
  @@unique([user_id, link])
  @@index([user_id])
}

enum SuggestionStatus {
  PROCESSING
  WAITING_FOR_INPUT
  COMPLETED
}

model UserSuggestion {
  id               String                      @id
  user_id          String
  user             User                        @relation(fields: [user_id], references: [auth0_id])
  experience_id    Int
  experience       UserBaseExperience          @relation(fields: [experience_id], references: [id])
  bullet_id        Int?
  bullet           UserBaseExperienceBullet?   @relation(fields: [bullet_id], references: [id])
  pending_question String?
  result           String?
  status           SuggestionStatus            @default(PROCESSING)
  created_at       DateTime                    @default(now())

  @@map("user_suggestion")

  @@index([user_id])
  @@unique([user_id, experience_id, bullet_id])
}
