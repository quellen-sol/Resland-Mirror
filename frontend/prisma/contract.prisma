// use prisma-next

model User {
  id        Int      @id @default(autoincrement())
  auth0Id   String   @unique()

  @@map("user")
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model UserUploadJob {
  id        String    @id
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  status    JobStatus
  createdAt DateTime  @default(now())

  @@map("user_upload_job")
}
