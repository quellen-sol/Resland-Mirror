// use prisma-next

model User {
  auth0Id      String   @id
  hasOnboarded Boolean  @default(false)
  createdAt    DateTime @default(now())
  // For resume headers
  fullName String?
  email String?
  phone String?
  location String?

  @@map("user")
  @@index([auth0Id])
}

enum SocialLinkType {
  LINKEDIN
  GITHUB
  WEBSITE
}

model UserSocialLink {
  id Int @id @default(autoincrement())
  link String
  type SocialLinkType
  userId String
  user User @relation(fields: [userId], references: [auth0Id])
  
  @@map("user_social_link")
  @@unique([userId, type])
  @@index([userId])
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model UserUploadJob {
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [auth0Id])
  status    JobStatus @default(PENDING)
  s3Key     String
  createdAt DateTime  @default(now())

  @@map("user_upload_job")
  @@index([userId])
}


// User "base" models, from resume generated data only
model UserBaseJobExperience {
  id          Int       @id @default(autoincrement())
  userId      String
  user        User      @relation(fields: [userId], references: [auth0Id])
  companyName String
  title       String
  startDate   DateTime
  endDate     DateTime?
  description String?
  createdAt   DateTime  @default(now())

  @@map("user_base_experience")
  @@index([userId])
}

model UserBaseJobExperienceBullet {
  id                   Int                   @id @default(autoincrement())
  userJobExperienceId  Int
  userJobExperience    UserBaseJobExperience @relation(fields: [userJobExperienceId], references: [id])
  bullet               String
  createdAt            DateTime              @default(now())
  
  @@map("user_base_experience_bullet")
  @@index([userJobExperienceId])
}

model UserBaseSkill {
  id          Int       @id @default(autoincrement())
  userId      String
  user        User      @relation(fields: [userId], references: [auth0Id])
  name        String
  category    String?
  
  @@map("user_base_skill")
  @@unique([userId, name])
  @@index([userId])
}

model UserBaseEducation {
  id Int @id @default(autoincrement())
  userId String  
  user User @relation(fields: [userId], references: [auth0Id])
  institution String
  degree String
  fieldOfStudy String
  startDate DateTime
  endDate DateTime?
  description String?
  
  @@map("user_base_education")
  @@unique([userId, institution, degree, fieldOfStudy, startDate])
  @@index([userId])
}

model UserBaseProject {
  id Int @id @default(autoincrement())
  userId String  
  user User @relation(fields: [userId], references: [auth0Id])
  name String
  link String?
  description String?
  startDate DateTime
  endDate DateTime?
  
  @@map("user_base_project")
  @@unique([userId, name, startDate])
  @@unique([userId, link])
  @@index([userId])
}
