# ------------------ Resland API ------------------ #
NEXT_PUBLIC_API_BASE_URL=http://api:3001


# ------------------ Auth0 ------------------ #
# The app's public origin (e.g. https://resland.org). Ignored on Vercel preview
# deployments, where the SDK infers the base URL from each request's host so
# dynamic preview URLs work (see lib/auth0.js). Unset locally -> also inferred.
APP_BASE_URL=
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=

# 64 character random string to encrypt the session cookie:
# `openssl rand -hex 32`
AUTH0_SECRET=


# ------------------ Prisma ------------------ #
DATABASE_URL=postgres://resland:resland@postgres:5432/resland

# Optional seed for site_settings.maintenance_mode on first read only — the
# admin dashboard owns the flag afterwards. Set to 1/true to keep a fresh
# deploy paused.
MAINTENANCE_MODE=
